<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_story"
    android:background="@color/main_background"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:background="@color/sidebar_background"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.3">
            <include
                android:id="@+id/circle_menu_left"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/circle_left_layout"/>
            <include
                android:id="@+id/circle_menu_right"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                layout="@layout/circle_right_layout"/>
        </FrameLayout>
        <include
            android:id="@+id/top_menu"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3.7"
            layout="@layout/topbar"/>
        <include
            android:id="@+id/bottom_menu_effects"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            layout="@layout/topbar_effects"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/main_linear_layout"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_weight="25">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1.1">
                <com.nabil.utilities.MyScrollView
                    android:id="@+id/main_scroll_text"
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:overScrollMode="never"
                    android:requiresFadingEdge="vertical">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/main_text"
                        android:gravity="center"
                        android:id="@+id/main_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"/>
                </com.nabil.utilities.MyScrollView>
            </RelativeLayout>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3.1"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_gravity="center"
            android:id="@+id/name_layout"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/main_text"
                android:gravity="center"
                android:id="@+id/character_text"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </RelativeLayout>
        <include
            android:id="@+id/bottom_menu"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            layout="@layout/bottombar"/>
    </LinearLayout>
    <include
        android:id="@+id/deck_content"
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        layout="@layout/deck_content"/>
    <include
        android:id="@+id/event_new_effect"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="-100dp"
        layout="@layout/event_new_effect"/>
</RelativeLayout>
