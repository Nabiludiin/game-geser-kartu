<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/settings_view"
        android:visibility="visible"
        android:scrollbars="none"
        android:fadingEdgeLength="50dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/option_text_disabled"
                android:id="@+id/version_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:layout_marginBottom="18dp"
                android:text="@string/game_version"
                android:layout_marginStart="21dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/option_text_disabled"
                android:id="@+id/version_subtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/app_version"
                android:layout_alignBottom="@+id/version_text"
                android:layout_marginEnd="21dp"
                android:layout_alignParentEnd="true"/>
            <View
                android:id="@+id/divider_2"
                android:layout_marginBottom="5dp"
                android:layout_below="@+id/version_text"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                style="@style/DividerHorizontal"/>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/music_view"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="5dp"
                android:layout_below="@+id/divider_2"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/option_text_enabled"
                    android:id="@+id/music_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:text="@string/music"
                    android:layout_centerVertical="true"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/music_switch"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="15dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    app:srcCompat="@drawable/phonograph"
                    app:tint="@color/option_text_enabled"/>
            </RelativeLayout>
            <RelativeLayout
                android:orientation="horizontal"
                android:id="@+id/effects_view"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_below="@+id/music_view"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/option_text_enabled"
                    android:id="@+id/effects_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:text="@string/sound_effects"
                    android:layout_centerVertical="true"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/effects_switch"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_margin="15dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    app:srcCompat="@drawable/speaker"
                    app:tint="@color/option_text_enabled"/>
            </RelativeLayout>
            <RelativeLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/language_layout"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:layout_below="@+id/effects_view"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_alignParentEnd="true">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/option_text_enabled"
                    android:id="@+id/language_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_language"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="5dp"/>
                <Spinner
                    android:gravity="center"
                    android:id="@+id/language_spinner"
                    android:background="@android:color/transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:popupBackground="@color/colorPrimary"
                    android:layout_centerVertical="true"
                    android:spinnerMode="dialog"
                    android:layout_marginEnd="8dp"
                    android:layout_toStartOf="@+id/spinner_image"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/spinner_image"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:tint="@color/option_text_enabled"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="5dp"
                    android:layout_alignParentEnd="true"
                    app:srcCompat="@drawable/next_arrow"/>
            </RelativeLayout>
            <include
                android:id="@+id/upgrade_layout"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="40dp"
                android:layout_below="@+id/language_layout"
                android:layout_marginStart="26dp"
                android:layout_marginEnd="26dp"
                layout="@layout/upgrade_layout"/>
            <Button
                android:textColor="@color/option_text_disabled"
                android:id="@+id/info_button"
                android:background="@drawable/my_button_bg"
                android:paddingTop="6dp"
                android:paddingBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="142dp"
                android:layout_marginBottom="24dp"
                android:text="@string/info_button"
                android:layout_below="@+id/language_layout"
                android:layout_centerHorizontal="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/play_games_button"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_margin="16dp"
                android:layout_below="@+id/info_button">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="50dp"
                    android:layout_height="40dp"
                    android:tint="@color/option_text_disabled"
                    app:srcCompat="@drawable/games_controller"/>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/play_games_text"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:text="@string/play_games_login"/>
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>
    <ScrollView
        android:id="@+id/eye_view"
        android:visibility="invisible"
        android:scrollbars="none"
        android:fadingEdgeLength="50dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/view_effect_0"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <ImageView
                    android:id="@+id/imageEffect0"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/imageEffect0">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/option_text_enabled"
                        android:id="@+id/titleEffect0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:text="@string/fortune"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/option_text_enabled"
                        android:id="@+id/detailsEffect0"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fortune_desc"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/view_effect_1"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <ImageView
                    android:id="@+id/imageEffect1"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/imageEffect1">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/option_text_enabled"
                        android:id="@+id/titleEffect1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:text="@string/fortune"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/option_text_enabled"
                        android:id="@+id/detailsEffect1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fortune_desc"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/view_effect_2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <ImageView
                    android:id="@+id/imageEffect2"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/imageEffect2">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/option_text_enabled"
                        android:id="@+id/titleEffect2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:text="@string/fortune"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/option_text_enabled"
                        android:id="@+id/detailsEffect2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fortune_desc"/>
                </LinearLayout>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/view_effect_3"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp">
                <ImageView
                    android:id="@+id/imageEffect3"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/imageEffect3">
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/option_text_enabled"
                        android:id="@+id/titleEffect3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:text="@string/fortune"/>
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/option_text_enabled"
                        android:id="@+id/detailsEffect3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fortune_desc"/>
                </LinearLayout>
            </RelativeLayout>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/option_text_disabled"
                android:gravity="center"
                android:id="@+id/no_effects"
                android:paddingTop="40dp"
                android:paddingBottom="32dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="18dp"
                android:text="@string/no_active_effects"
                android:lineSpacingExtra="3dp"/>
            <View
                android:id="@+id/divider_shop"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                style="@style/DividerHorizontal"/>
            <TextView
                android:textSize="22sp"
                android:textColor="@color/option_text_enabled"
                android:id="@+id/shop_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/shop"
                android:layout_marginStart="18dp"/>
            <include
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp"
                layout="@layout/oracle_item"/>
            <include
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp"
                layout="@layout/second_chance_item"/>
            <include
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="20dp"
                layout="@layout/clover_item"/>
            <View
                android:id="@+id/divider_ads_info"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="30dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                style="@style/DividerHorizontal"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/option_text_disabled"
                android:gravity="center"
                android:id="@+id/ads_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="@string/ads_info"
                android:lineSpacingExtra="4dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"/>
            <include
                android:id="@+id/upgrade_layout_effects"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginBottom="42dp"
                android:layout_marginStart="21dp"
                android:layout_marginEnd="21dp"
                layout="@layout/upgrade_layout"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/tower_view"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp">
        <FrameLayout
            android:id="@+id/storyline_touch"
            android:layout_width="match_parent"
            android:layout_height="70dp">
            <LinearLayout
                android:layout_gravity="start|center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="54dp">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/option_text_enabled"
                    android:id="@+id/story_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/storyline_level"/>
                <ProgressBar
                    android:id="@+id/progressbar_storyline"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:max="26"
                    android:progress="0"
                    android:secondaryProgress="0"
                    android:progressDrawable="@drawable/my_progressbar"
                    style="?android:attr/progressBarStyleHorizontal"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/share_image"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:tint="@color/option_text_enabled"
                android:layout_marginEnd="16dp"
                app:srcCompat="@drawable/next_arrow"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/characters_touch"
            android:layout_width="match_parent"
            android:layout_height="70dp">
            <LinearLayout
                android:layout_gravity="start|center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="54dp">
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/option_text_enabled"
                    android:gravity="start|center_vertical"
                    android:id="@+id/characters_text"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginBottom="6dp"
                    android:text="@string/gallery"/>
                <ProgressBar
                    android:id="@+id/progressbar_characters"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:max="24"
                    android:progress="0"
                    android:secondaryProgress="0"
                    android:progressDrawable="@drawable/my_progressbar"
                    style="?android:attr/progressBarStyleHorizontal"/>
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/play_image"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:tint="@color/option_text_enabled"
                android:layout_marginEnd="16dp"
                app:srcCompat="@drawable/next_arrow"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/record_touch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="24sp"
                android:textColor="@color/option_text_enabled"
                android:gravity="start|center_vertical"
                android:id="@+id/record_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="6dp"
                android:text="@string/high_score"
                android:layout_marginStart="16dp"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/record_image"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:tint="@color/option_text_enabled"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:srcCompat="@drawable/next_arrow"/>
        </FrameLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:textSize="38sp"
                android:textColor="@color/colorAccent"
                android:gravity="start|center_vertical"
                android:id="@+id/record_1_number"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="1"
                android:layout_marginStart="16dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/option_text_disabled"
                android:gravity="start|center_vertical"
                android:id="@+id/record_1_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="In carica per\101 anno e 172 giorni (Anno 2078)"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@+id/record_1_number"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:textSize="38sp"
                android:textColor="@color/colorAccent"
                android:gravity="start|center_vertical"
                android:id="@+id/record_2_number"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="2"
                android:layout_marginStart="16dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/option_text_disabled"
                android:gravity="start|center_vertical"
                android:id="@+id/record_2_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="In carica per\101 anno e 47 giorni (Anno 2080)"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@+id/record_2_number"/>
        </RelativeLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">
            <TextView
                android:textSize="38sp"
                android:textColor="@color/colorAccent"
                android:gravity="start|center_vertical"
                android:id="@+id/record_3_number"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="3"
                android:layout_marginStart="16dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/option_text_disabled"
                android:gravity="start|center_vertical"
                android:id="@+id/record_3_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="In carica per\10324 giorni (Anno 2079)"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@+id/record_3_number"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
