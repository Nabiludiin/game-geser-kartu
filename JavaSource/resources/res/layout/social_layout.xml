<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/facebook_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:layout_weight="1">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:tint="@color/option_text_disabled"
            app:srcCompat="@drawable/social_facebook"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/option_text_enabled"
            android:layout_gravity="center"
            android:id="@+id/facebook_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="FACEBOOK"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/instagram_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:tint="@color/option_text_disabled"
        android:layout_weight="1">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:tint="@color/option_text_disabled"
            app:srcCompat="@drawable/social_instagram"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/option_text_enabled"
            android:layout_gravity="center"
            android:id="@+id/instagram_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="INSTAGRAM"/>
    </LinearLayout>
</LinearLayout>
