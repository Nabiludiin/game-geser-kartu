<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_horizontal"
    android:layout_gravity="center"
    android:id="@+id/card_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="4dp"
    android:layoutDirection="ltr"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/offer_image"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/left_layout"
            android:background="@drawable/gradient_transparent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:weightSum="1"
            app:layout_constraintHeight_default="percent"
            app:layout_constraintHeight_percent="0.4">
            <TextView
                android:textSize="19sp"
                android:textColor="@color/card_text"
                android:gravity="center"
                android:id="@+id/left_image"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Scelta Positiva"
                android:paddingStart="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.32"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.7"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="end"
            android:id="@+id/right_layout"
            android:background="@drawable/gradient_transparent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintHeight_default="percent"
            app:layout_constraintHeight_percent="0.4">
            <TextView
                android:textSize="19sp"
                android:textColor="@color/card_text"
                android:gravity="center"
                android:id="@+id/right_image"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Scelta Negativa"
                android:paddingEnd="20dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.32"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.7"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/event_card_text"
            android:gravity="center"
            android:id="@+id/event_card_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="18dp"
            android:layout_centerInParent="true"
            android:lineSpacingExtra="2dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:weightSum="1">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/card_effect_symbol"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_margin="10dp"
                android:layout_weight="0.16"/>
            <TextView
                android:textSize="21sp"
                android:textColor="@color/event_card_text"
                android:gravity="center"
                android:id="@+id/card_effect_title"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.1"/>
            <TextView
                android:textSize="18sp"
                android:textColor="@color/event_card_text"
                android:gravity="center"
                android:id="@+id/card_effect_description"
                android:paddingTop="2dp"
                android:paddingBottom="6dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.74"
                android:lineSpacingExtra="2dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
