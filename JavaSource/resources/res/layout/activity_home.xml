<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen"
    android:background="@color/start_screen_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/settings_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:tint="@color/option_text_disabled"
        app:layout_constraintBottom_toTopOf="@+id/year_text"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.165"
        app:srcCompat="@drawable/settings"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/geser_2_layout"
        android:background="@drawable/my_button_bg_lite"
        android:padding="6dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        app:layout_constraintBottom_toTopOf="@+id/year_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/settings_icon">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:id="@+id/icon_geser2"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:tint="@color/option_text_enabled"
            android:paddingStart="4dp"
            app:srcCompat="@drawable/geser2_logo"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/option_text_enabled"
            android:gravity="center"
            android:id="@+id/text_geser2"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/geser_2_name"
            android:paddingStart="5dp"
            android:paddingEnd="3dp"/>
    </LinearLayout>
    <TextView
        android:textSize="40sp"
        android:textColor="@color/title_text"
        android:gravity="center"
        android:id="@+id/year_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/year_home_text"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.361"/>
    <TextView
        android:textSize="60sp"
        android:textColor="@color/title_text"
        android:gravity="center"
        android:id="@+id/year_count"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="7dp"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/year_text"
        app:layout_constraintVertical_bias="0.009"/>
    <RelativeLayout
        android:id="@+id/continue_layout"
        android:background="@color/continue_background"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/year_count">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/topTape"
            android:background="@color/continue_border"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_alignParentTop="true"/>
        <TextView
            android:textSize="20sp"
            android:textColor="@color/continue_text"
            android:gravity="center"
            android:id="@+id/continue_text"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/continue_home_text"
            android:layout_centerInParent="true"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/continue_image"
            android:visibility="invisible"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:tint="@color/continue_text"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/continue_text"
            app:srcCompat="@drawable/next_arrow"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/bottomTape"
            android:background="@color/continue_border"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="20dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
