<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/settings_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="5dp"
    android:paddingEnd="5dp">
    <RelativeLayout
        android:id="@+id/top"
        android:background="@color/settings_background"
        android:layout_width="match_parent"
        android:layout_height="90dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/close_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_margin="12dp"
            android:tint="@color/option_text_enabled"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:srcCompat="@drawable/ic_clear_black_24dp"/>
        <TextView
            android:textSize="22sp"
            android:textColor="@color/option_text_enabled"
            android:id="@+id/title"
            android:padding="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:text="@string/info"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <ScrollView
        android:id="@+id/infoContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/option_text_enabled"
                android:id="@+id/copyright_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:text="@string/copyright"/>
            <View
                android:id="@+id/divider_info"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                style="@style/DividerHorizontal"/>
            <LinearLayout
                android:layout_gravity="start|center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/option_text_disabled"
                    android:id="@+id/developer_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/developer_title"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/option_text_disabled"
                    android:id="@+id/developer_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nabil"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="start|center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/option_text_disabled"
                    android:id="@+id/graphic_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/graphic_title"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/option_text_disabled"
                    android:id="@+id/graphic_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— Nabil"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="start|center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/option_text_disabled"
                    android:id="@+id/translation_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/translation_title"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/option_text_disabled"
                    android:id="@+id/translation_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/translator_list"
                    android:lineSpacingExtra="1dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="start|center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/option_text_disabled"
                    android:id="@+id/sounds_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/sounds_title"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/option_text_disabled"
                    android:id="@+id/sounds_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="— Nabil"
                    android:lineSpacingExtra="1dp"/>
            </LinearLayout>
            <LinearLayout
                android:layout_gravity="start|center_vertical"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/option_text_disabled"
                    android:id="@+id/license_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/licenses_title"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/option_text_disabled"
                    android:id="@+id/license_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/license_name"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/option_text_disabled"
                android:id="@+id/license_content"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:text="@string/license"/>
            <include
                android:id="@+id/social_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                layout="@layout/social_layout"/>
            <TextView
                android:textColor="@color/option_text_disabled"
                android:layout_gravity="center"
                android:id="@+id/my_site_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:text="@string/my_site"/>
            <TextView
                android:textColor="@color/option_text_disabled"
                android:layout_gravity="center"
                android:id="@+id/hard_reset_button"
                android:background="@drawable/my_button_bg"
                android:paddingTop="6dp"
                android:paddingBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="28dp"
                android:text="@string/reset_game_button"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
