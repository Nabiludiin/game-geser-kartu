<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/colorAccent"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/topTape"
        android:background="@color/event_border"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_alignParentTop="true"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignTop="@+id/topTape"
        android:layout_alignBottom="@+id/bottomTape">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginStart="10dp">
            <TextView
                android:textSize="20sp"
                android:textColor="@color/event_text"
                android:gravity="center"
                android:id="@+id/titleEffect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Unknown Title"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/event_subtext"
                android:gravity="center"
                android:id="@+id/detailsEffect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Something happened"
                android:layout_below="@+id/titleEffect"/>
        </RelativeLayout>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/bottomTape"
        android:background="@color/event_border"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_alignParentBottom="true"/>
</RelativeLayout>
