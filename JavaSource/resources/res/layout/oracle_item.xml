<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <ImageView
            android:id="@+id/item_image_3"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/oracle_purchase"
            android:layout_alignParentTop="true"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/item_text_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/item_image_3">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/option_text_enabled"
                android:id="@+id/item_title_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="@string/oracle"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/option_text_enabled"
                android:id="@+id/item_description_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/oracle_desc"/>
        </LinearLayout>
    </RelativeLayout>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/option_text_disabled"
        android:id="@+id/item_amount_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/availability"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <HorizontalScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/option_text_enabled"
                android:id="@+id/item_shop_3x1"
                android:background="@drawable/my_button_bg_lite"
                android:paddingTop="8dp"
                android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/oracle_x1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/option_text_enabled"
                android:id="@+id/item_shop_3x2"
                android:background="@drawable/my_button_bg_lite"
                android:paddingTop="8dp"
                android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/oracle_x2"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/option_text_enabled"
                android:id="@+id/item_shop_3x3"
                android:background="@drawable/my_button_bg_lite"
                android:paddingTop="8dp"
                android:paddingBottom="7dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/oracle_x3"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="8dp"/>
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
