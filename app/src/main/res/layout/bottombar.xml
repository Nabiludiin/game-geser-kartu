<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@color/sidebar_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="18dp"
    android:paddingEnd="18dp">
    <TextView
        android:textSize="22sp"
        android:textColor="@color/sidebar_text"
        android:gravity="center"
        android:id="@+id/year_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2075"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="22sp"
            android:textColor="@color/sidebar_text"
            android:gravity="start|center_vertical"
            android:id="@+id/years_count"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/sidebar_text"
            android:gravity="start|center_vertical"
            android:id="@+id/yeasr_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="22sp"
            android:textColor="@color/sidebar_text"
            android:gravity="start|center_vertical"
            android:id="@+id/days_count"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/sidebar_text"
            android:gravity="start|center_vertical"
            android:id="@+id/days_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/sidebar_text"
            android:gravity="center"
            android:id="@+id/in_office_text"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/in_power_min"/>
    </LinearLayout>
</LinearLayout>
