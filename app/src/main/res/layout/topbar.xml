<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@color/sidebar_background"
    android:paddingTop="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:paddingStart="18dp"
    android:paddingEnd="18dp">
    <FrameLayout
        android:layout_gravity="center"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        android:layout_weight="1">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/imageEmpty1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/plant"
            android:adjustViewBounds="true"
            android:maxHeight="48dp"
            android:tint="@color/stats_empty"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/imageFull1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/plant_clip"
            android:adjustViewBounds="true"
            android:maxHeight="48dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|top"
            android:id="@+id/arrow1"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/down_arrow"
            android:tint="@color/red"
            android:layout_marginEnd="10dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        android:layout_weight="1">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/imageEmpty2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/people"
            android:adjustViewBounds="true"
            android:maxHeight="48dp"
            android:tint="@color/stats_empty"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/imageFull2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/people_clip"
            android:adjustViewBounds="true"
            android:maxHeight="48dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|top"
            android:id="@+id/arrow2"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/down_arrow"
            android:tint="@color/red"
            android:layout_marginEnd="10dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        android:layout_weight="1">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/imageEmpty3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/gun"
            android:adjustViewBounds="true"
            android:maxHeight="48dp"
            android:tint="@color/stats_empty"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/imageFull3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/gun_clip"
            android:adjustViewBounds="true"
            android:maxHeight="48dp"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="end|top"
            android:id="@+id/arrow3"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/down_arrow"
            android:tint="@color/red"
            android:layout_marginEnd="10dp"/>
    </FrameLayout>
    <FrameLayout
        android:layout_gravity="center"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="8dp"
        android:layout_weight="1">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/imageEmpty4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/money"
            android:adjustViewBounds="true"
            android:maxHeight="48dp"
            android:tint="@color/stats_empty"/>
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/imageFull4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/money_clip"
            android:adjustViewBounds="true"
            android:maxHeight="48dp"/>
    </FrameLayout>
</LinearLayout>
